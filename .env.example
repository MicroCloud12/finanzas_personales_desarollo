# ==============================================================================
# Plantilla de configuración (.env.example)
# Copia este archivo como `.env` y rellena los valores reales. Nunca subas `.env`.
# ==============================================================================

# --- Django & Seguridad ---
SECRET_KEY=cambia-esta-clave-secreta-de-django
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Cifrado de Base de Datos (Nivel 2 - CRÍTICO: guarda respaldo en tu gestor de contraseñas) ---
# Genera una llave nueva ejecutando: python manage.py generar_llave_cifrado
# Para rotar llave maestra: DATA_ENCRYPTION_KEY=LLAVE_NUEVA,LLAVE_ANTERIOR y corre `generar_llave_cifrado --rotar`
DATA_ENCRYPTION_KEY=

# --- Base de Datos MySQL (y Docker Compose) ---
MYSQL_ROOT_PASSWORD=cambia-password-root-mysql
DB_NAME=finanzas_db
DB_USER=finanzas_user
DB_PASSWORD=cambia-password-usuario-mysql
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Inteligencia Artificial (Tickets, Facturas y Recibos) ---
GEMINI_API_KEY=
MISTRAL_API_KEY=

# --- Datos de Mercado y Divisas ---
TWELVEDATA_API_KEY=
CURRENCYAPI_API_KEY=

# --- Pagos (Mercado Pago) y Google RISC ---
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PLAN_ID=
GOOGLE_CLIENT_ID=

# --- Correo Electrónico (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
